{
  "name": "organizations",
  "version": "1.0.0",
  "description": "Organizations JSON API",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:latest",
    "migrate:rollback": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:rollback",
    "test": "node --import tsx ./node_modules/mocha/bin/mocha.js --timeout 10000 --exit \"test/**/*.test.ts\""
  },
  "author": "Taavi Kala",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^2.3.0",
    "chai": "^4.2.0",
    "chai-http": "^5.1.1",
    "express": "^5.2.0",
    "knex": "^2.4.0",
    "mocha": "^12.0.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/chai": "^4.3.20",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "eslint": "^8.33.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.6.1",
    "eslint-plugin-promise": "^6.1.1",
    "supertest": "^6.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
