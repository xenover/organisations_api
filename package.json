{
  "name": "organizations",
  "version": "1.0.0",
  "description": "Organizations JSON API",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": "^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:latest",
    "migrate:rollback": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:rollback",
    "test": "node --no-experimental-require-module --import tsx --import ./test/setup.ts ./node_modules/mocha/bin/mocha.js --timeout 10000 \"test/**/*.test.ts\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "test:watch": "tsx watch --clear-screen=false --include \"test/**/*.ts\" --include \"src/**/*.ts\" --include \"migrations/**/*.js\" --include knexfile.ts --no-experimental-require-module --import ./test/setup.ts ./node_modules/mocha/bin/mocha.js --timeout 10000 \"test/**/*.test.ts\"",
    "test:debug": "node --no-experimental-require-module --inspect-brk --import tsx --import ./test/setup.ts ./node_modules/mocha/bin/mocha.js --timeout 0 \"test/**/*.test.ts\"",
    "test:coverage": "c8 npm test"
  },
  "author": "Taavi Kala",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "pino": "^10.4.0",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "c8": "^12.0.0",
    "chai": "^5.3.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "prettier": "^3.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
