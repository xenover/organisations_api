{
  "all": true,
  "extension": [".ts", ".js"],
  "include": ["src/**/*.ts", "server.ts", "knexfile.ts", "migrations/**/*.js"],
  "exclude": ["src/types/**/*.ts"],
  "reporter": ["text", "html", "lcov", "json-summary"],
  "exclude-after-remap": true,
  "check-coverage": true,
  "lines": 95,
  "statements": 95,
  "functions": 95,
  "branches": 90
}
