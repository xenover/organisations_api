{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "allowJs": true,
    "checkJs": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "knexfile.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "migrations/**/*.js"
  ],
  "exclude": ["node_modules", "dist"]
}
